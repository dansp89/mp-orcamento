# App
PORT=9876
# Cache local em memória para Price List pública (default: 21600000 = 6h)
AWS_PRICE_CACHE_TTL_MS=21600000
# hcloud token (opcional no env; também pode enviar por header x-hcloud-token)
HCLOUD_TOKEN=
# Cache local em memória para catálogo hcloud (default: 3600000 = 1h)
HCLOUD_CACHE_TTL_MS=3600000
# Cache local em memória para catálogo público da HADCloud (default: 3600000 = 1h)
HADCLOUD_CACHE_TTL_MS=3600000
